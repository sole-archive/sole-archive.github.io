---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import papers from '../../content/papers.json';

function toRoman(n: number): string {
  const vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1];
  const syms = ['M','CM','D','CD','C','XC','L','XL','X','IX','V','IV','I'];
  let result = '';
  for (let i = 0; i < vals.length; i++) {
    while (n >= vals[i]) { result += syms[i]; n -= vals[i]; }
  }
  return result;
}

export async function getStaticPaths() {
  type Paper = typeof papers[number];
  const editionMap = new Map<string, {
    edition: string; year: number; editors: string[];
    venue: string; slug: string; papers: Paper[];
  }>();

  for (const paper of papers) {
    const slug = paper.edition.toLowerCase().replace(/\s+/g, '-');
    if (!editionMap.has(paper.edition)) {
      editionMap.set(paper.edition, {
        edition: paper.edition,
        year: paper.year,
        editors: paper.editors,
        venue: paper.console_venue,
        slug,
        papers: [],
      });
    }
    editionMap.get(paper.edition)!.papers.push(paper);
  }

  return Array.from(editionMap.values()).map(volume => ({
    params: { slug: volume.slug },
    props: { volume },
  }));
}

const { volume } = Astro.props;

const sortedPapers = [...volume.papers]
  .sort((a, b) => {
    const pa = parseInt(a.pages.split('-')[0]) || 0;
    const pb = parseInt(b.pages.split('-')[0]) || 0;
    return pa - pb;
  })
  .map(paper => {
    const n = paper.authors.length;
    const authorsDisplay = n === 1
      ? paper.authors[0]
      : `${paper.authors.slice(0, -1).join(', ')} & ${paper.authors[n - 1]}`;
    return { ...paper, authorsDisplay };
  });

const num = parseInt(volume.edition.replace('ConSOLE ', '').trim());
const roman = toRoman(num);
const displayTitle = `ConSOLE ${roman}`;
const fullTitle = `Proceedings of ConSOLE ${roman}`;
---

<Layout
  title={`${fullTitle} - SOLE Archive`}
  description={`${fullTitle}, edited by ${volume.editors.join(', ')}. ${sortedPapers.length} papers from ${volume.venue}.`}
  ogImage={`/og/${volume.slug}.png`}
>
  <Navigation currentPage="volumes" />

  <!-- Breadcrumb -->
  <section class="bg-surface py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center space-x-2 text-sm">
        <a href="/" class="text-text-secondary hover:text-primary transition-smooth">Home</a>
        <svg class="w-4 h-4 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <a href="/volumes" class="text-text-secondary hover:text-primary transition-smooth">Volumes</a>
        <svg class="w-4 h-4 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span class="text-primary font-medium">{displayTitle}</span>
      </nav>
    </div>
  </section>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Volume header: metadata (left) + cover (right) -->
    <div class="flex gap-6 sm:gap-10 mb-12 items-start">

      <!-- Left: metadata -->
      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="text-text-secondary font-mono text-sm">{volume.year}</span>
          <span class="px-3 py-1 bg-primary-100 text-primary-800 font-semibold rounded-full text-xs">{volume.edition}</span>
          <a href={`/ig/vol/${volume.slug}.png`} download={`${volume.slug}.png`} class="p-1.5 text-text-secondary hover:text-accent transition-smooth" title="Download Instagram card">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-crimson font-semibold text-primary mb-4 leading-tight">
          {fullTitle}
        </h1>

        <!-- Venue -->
        <div class="flex items-start gap-2 text-text-secondary mb-4">
          <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span class="text-sm">{volume.venue}</span>
        </div>

        <!-- Editors -->
        {volume.editors.length > 0 && (
          <p class="text-sm text-text-secondary mb-4">
            <span class="font-semibold text-text-primary">Edited by:</span> {volume.editors.join(', ')}
          </p>
        )}

        <p class="text-sm text-text-secondary font-mono">{sortedPapers.length} papers</p>
      </div>

      <!-- Right: cover -->
      <div class="flex-shrink-0 w-36 sm:w-44 md:w-52">
        <div class="vcl-cover" style="width:100%;aspect-ratio:5/7;position:relative;overflow:hidden;background:linear-gradient(155deg,#0e1f57 0%,#1e3a8a 45%,#1c3fb5 100%);border-radius:2px 7px 7px 2px;box-shadow:-4px 5px 16px rgba(0,0,0,0.42),-1px 1px 0 rgba(0,0,0,0.22),inset 0 0 0 1px rgba(245,158,11,0.16);">
          <div class="vcl-spine"></div>
          <img src="/logo.png" alt="" class="vcl-map" aria-hidden="true" />
          <div class="vcl-content">
            <div class="vcl-header-rule">
              <span class="vcl-brand">SOLE</span>
            </div>
            <div class="vcl-middle">
              <span class="vcl-roman">{roman}</span>
              <span class="vcl-year-label">ConSOLE · {volume.year}</span>
            </div>
            <div class="vcl-footer">
              <div class="vcl-rule"></div>
              <div class="vcl-editors">
                {volume.editors.map(e => <p class="vcl-editor">{e}</p>)}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Papers list -->
    <div class="card">
      <h2 class="text-2xl font-crimson font-semibold text-primary mb-6">Papers in this volume</h2>
      <div class="divide-y divide-border">
        {sortedPapers.map(paper => (
          <div class="py-4 flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-4 hover:bg-surface transition-smooth px-2 -mx-2 rounded">
            <span class="font-mono text-xs text-text-secondary w-16 flex-shrink-0 pt-0.5">{paper.pages}</span>
            <div class="flex-1 min-w-0">
              <a href={`/paper/${paper.slug}`} class="font-crimson font-semibold text-primary hover:text-primary-700 transition-smooth leading-snug">
                {paper.title}
              </a>
              <p class="text-sm text-text-secondary mt-0.5">{paper.authorsDisplay}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </main>

  <!-- Footer -->
  <footer class="bg-primary text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-4 gap-8">
        <div class="md:col-span-2">
          <div class="flex items-center space-x-3 mb-4">
            <img src="/logo.png" alt="SOLE Archive" class="w-8 h-8 object-contain" loading="eager" style="filter: invert(1);" />
            <div>
              <h3 class="text-xl font-crimson font-semibold">SOLE Archive</h3>
              <p class="text-sm text-primary-200 font-mono">ConSOLE Proceedings</p>
            </div>
          </div>
          <p class="text-primary-100 mb-4 max-w-md">Archive of the ConSOLE proceedings, from 2000 to 2025.</p>
          <div class="flex space-x-4">
            <a href="https://www.linkedin.com/company/student-organization-of-linguistics-in-europe/posts/?feedView=all" target="_blank" rel="noopener noreferrer" class="text-primary-200 hover:text-white transition-smooth">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          </div>
        </div>
        <div>
          <h4 class="font-crimson font-semibold mb-4">Quick Links</h4>
          <ul class="space-y-2 text-primary-100">
            <li><a href="/" class="hover:text-white transition-smooth">Home</a></li>
            <li><a href="/papers" class="hover:text-white transition-smooth">Browse Papers</a></li>
            <li><a href="/volumes" class="hover:text-white transition-smooth">Volumes</a></li>
            <li><a href="/analytics" class="hover:text-white transition-smooth">Analytics</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-crimson font-semibold mb-4">Resources</h4>
          <ul class="space-y-2 text-primary-100">
            <li><a href="https://www.universiteitleiden.nl/en/events/series/sole" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-smooth">About SOLE</a></li>
            <li><a href="mailto:sole.leiden@gmail.com" class="hover:text-white transition-smooth">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-primary-700 mt-8 pt-8 flex flex-col md:flex-row justify-between items-center">
        <p class="text-primary-200 text-sm">© 2025 SOLE Archive. Website built by <a href="https://tomsgrizzi.github.io/" class="hover:text-white transition-smooth">Tommaso Sgrizzi</a>.</p>
      </div>
    </div>
  </footer>
</Layout>

<style>
  .vcl-cover {
    width: 100%;
    aspect-ratio: 5 / 7;
    position: relative;
    border-radius: 2px 7px 7px 2px;
    overflow: hidden;
    background: linear-gradient(155deg, #0e1f57 0%, #1e3a8a 45%, #1c3fb5 100%);
    box-shadow:
      -4px 5px 16px rgba(0, 0, 0, 0.42),
      -1px 1px 0 rgba(0, 0, 0, 0.22),
      inset 0 0 0 1px rgba(245, 158, 11, 0.16);
  }

  .vcl-spine {
    position: absolute;
    left: 0; top: 0; bottom: 0; width: 6px;
    background: linear-gradient(to right, rgba(0, 0, 0, 0.42), transparent);
    z-index: 2;
  }

  .vcl-map {
    position: absolute;
    width: 130%;
    top: 48%;
    left: 55%;
    transform: translate(-50%, -50%);
    filter: invert(1);
    opacity: 0.09;
    pointer-events: none;
    user-select: none;
    z-index: 1;
  }

  .vcl-content {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.85rem 0.7rem;
  }

  /* ─── SOLE ─── rule */
  .vcl-header-rule {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .vcl-header-rule::before,
  .vcl-header-rule::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(245, 158, 11, 0.45);
  }

  .vcl-brand {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.48rem;
    letter-spacing: 0.35em;
    color: rgba(245, 158, 11, 0.88);
    white-space: nowrap;
  }

  .vcl-middle {
    text-align: center;
  }

  .vcl-roman {
    display: block;
    font-family: 'Crimson Text', Georgia, serif;
    font-weight: 600;
    color: white;
    font-size: clamp(1.5rem, 4vw, 2.3rem);
    line-height: 1;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.5);
  }

  .vcl-year-label {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.56rem;
    letter-spacing: 0.07em;
    color: rgba(255, 255, 255, 0.42);
    margin-top: 0.35rem;
  }

  .vcl-rule {
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(245, 158, 11, 0.42), transparent);
    margin-bottom: 0.3rem;
  }

  .vcl-editors {
    text-align: center;
  }

  .vcl-editor {
    font-family: 'Crimson Text', Georgia, serif;
    font-style: italic;
    font-size: 0.48rem;
    color: rgba(255, 255, 255, 0.52);
    line-height: 1.5;
  }
</style>
