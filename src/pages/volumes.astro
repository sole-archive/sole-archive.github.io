---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import papers from '../content/papers.json';

function toRoman(n: number): string {
  const vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1];
  const syms = ['M','CM','D','CD','C','XC','L','XL','X','IX','V','IV','I'];
  let result = '';
  for (let i = 0; i < vals.length; i++) {
    while (n >= vals[i]) { result += syms[i]; n -= vals[i]; }
  }
  return result;
}

const editionMap = new Map<string, {
  edition: string; year: number; editors: string[];
  venue: string; count: number; slug: string;
}>();

for (const paper of papers) {
  const slug = paper.edition.toLowerCase().replace(/\s+/g, '-');
  if (!editionMap.has(paper.edition)) {
    editionMap.set(paper.edition, {
      edition: paper.edition,
      year: paper.year,
      editors: paper.editors,
      venue: paper.console_venue,
      count: 0,
      slug,
    });
  }
  editionMap.get(paper.edition)!.count++;
}

const volumes = Array.from(editionMap.values())
  .sort((a, b) => b.year - a.year)
  .map(vol => {
    const num = parseInt(vol.edition.replace('ConSOLE ', '').trim());
    return { ...vol, roman: toRoman(num) };
  });
---

<Layout title="Proceedings Volumes - SOLE Archive" description="Browse all ConSOLE proceedings volumes from 2000 to 2025.">
  <Navigation currentPage="volumes" />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary-50 to-accent-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="hero-heading font-crimson font-semibold text-primary mb-4">Proceedings Volumes</h1>
      <p class="text-xl text-text-secondary max-w-2xl mx-auto">
        {volumes.length} volumes of ConSOLE proceedings spanning over two decades of student linguistics research.
      </p>
    </div>
  </section>

  <!-- Volumes Grid -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5" style="gap: 4rem 2.5rem;">
        {volumes.map(vol => (
          <a href={`/volume/${vol.slug}`} class="book-card flex flex-col items-center gap-3">
            <div class="book-cover w-full">
              <div class="book-spine"></div>
              <img src="/logo.png" alt="" class="book-map" aria-hidden="true" />
              <div class="book-content">
                <div class="book-header-rule">
                  <span class="book-brand">SOLE</span>
                </div>
                <div class="book-middle">
                  <span class="book-roman">{vol.roman}</span>
                  <span class="book-year-label">ConSOLE · {vol.year}</span>
                </div>
                <div class="book-footer">
                  <div class="book-rule"></div>
                  <div class="book-editors-list">
                    {vol.editors.map(e => <p class="book-editor-item">{e}</p>)}
                  </div>
                </div>
              </div>
            </div>
            <div class="text-center w-full">
              <h3 class="font-crimson font-semibold text-primary text-sm leading-tight">ConSOLE {vol.roman}</h3>
              <p class="text-xs text-text-secondary font-mono mt-0.5">{vol.count} papers</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-primary text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-4 gap-8">
        <div class="md:col-span-2">
          <div class="flex items-center space-x-3 mb-4">
            <img src="/logo.png" alt="SOLE Archive" class="w-8 h-8 object-contain" loading="eager" style="filter: invert(1);" />
            <div>
              <h3 class="text-xl font-crimson font-semibold">SOLE Archive</h3>
              <p class="text-sm text-primary-200 font-mono">ConSOLE Proceedings</p>
            </div>
          </div>
          <p class="text-primary-100 mb-4 max-w-md">Archive of the ConSOLE proceedings, from 2000 to 2025.</p>
          <div class="flex space-x-4">
            <a href="https://www.linkedin.com/company/student-organization-of-linguistics-in-europe/posts/?feedView=all" target="_blank" rel="noopener noreferrer" class="text-primary-200 hover:text-white transition-smooth">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          </div>
        </div>
        <div>
          <h4 class="font-crimson font-semibold mb-4">Quick Links</h4>
          <ul class="space-y-2 text-primary-100">
            <li><a href="/" class="hover:text-white transition-smooth">Home</a></li>
            <li><a href="/papers" class="hover:text-white transition-smooth">Browse Papers</a></li>
            <li><a href="/volumes" class="hover:text-white transition-smooth">Volumes</a></li>
            <li><a href="/analytics" class="hover:text-white transition-smooth">Analytics</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-crimson font-semibold mb-4">Resources</h4>
          <ul class="space-y-2 text-primary-100">
            <li><a href="https://www.universiteitleiden.nl/en/events/series/sole" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-smooth">About SOLE</a></li>
            <li><a href="mailto:sole.leiden@gmail.com" class="hover:text-white transition-smooth">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-primary-700 mt-8 pt-8 flex flex-col md:flex-row justify-between items-center">
        <p class="text-primary-200 text-sm">© 2025 SOLE Archive. Website built by <a href="https://tomsgrizzi.github.io/" class="hover:text-white transition-smooth">Tommaso Sgrizzi</a>.</p>
      </div>
    </div>
  </footer>
</Layout>

<style>
  .hero-heading {
    font-size: 3rem;
  }
  @media (min-width: 640px) {
    .hero-heading { font-size: 3.75rem; }
  }
  @media (min-width: 1024px) {
    .hero-heading { font-size: 4.5rem; }
  }

  .book-card {
    text-decoration: none;
    cursor: pointer;
  }

  .book-card .book-cover {
    aspect-ratio: 5 / 7;
    position: relative;
    border-radius: 2px 7px 7px 2px;
    overflow: hidden;
    background: linear-gradient(155deg, #0e1f57 0%, #1e3a8a 45%, #1c3fb5 100%);
    box-shadow:
      -4px 5px 16px rgba(0, 0, 0, 0.42),
      -1px 1px 0 rgba(0, 0, 0, 0.22),
      inset 0 0 0 1px rgba(245, 158, 11, 0.16);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .book-card:hover .book-cover {
    transform: translateY(-7px) rotate(0.5deg);
    box-shadow:
      -6px 12px 28px rgba(0, 0, 0, 0.48),
      -1px 1px 0 rgba(0, 0, 0, 0.22),
      inset 0 0 0 1px rgba(245, 158, 11, 0.28);
  }

  .book-spine {
    position: absolute;
    left: 0; top: 0; bottom: 0; width: 6px;
    background: linear-gradient(to right, rgba(0, 0, 0, 0.42), transparent);
    z-index: 2;
  }

  .book-map {
    position: absolute;
    width: 130%;
    top: 48%;
    left: 55%;
    transform: translate(-50%, -50%);
    filter: invert(1);
    opacity: 0.09;
    pointer-events: none;
    user-select: none;
    z-index: 1;
  }

  .book-content {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.85rem 0.7rem;
  }

  /* ─── SOLE ─── rule */
  .book-header-rule {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .book-header-rule::before,
  .book-header-rule::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(245, 158, 11, 0.45);
  }

  .book-brand {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.48rem;
    letter-spacing: 0.35em;
    color: rgba(245, 158, 11, 0.88);
    white-space: nowrap;
  }

  .book-middle {
    text-align: center;
  }

  .book-roman {
    display: block;
    font-family: 'Crimson Text', Georgia, serif;
    font-weight: 600;
    color: white;
    line-height: 1;
    font-size: clamp(1.5rem, 4vw, 2.3rem);
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.5);
  }

  .book-year-label {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.56rem;
    letter-spacing: 0.07em;
    color: rgba(255, 255, 255, 0.42);
    margin-top: 0.35rem;
  }

  .book-rule {
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(245, 158, 11, 0.42), transparent);
    margin-bottom: 0.3rem;
  }

  .book-editors-list {
    text-align: center;
  }

  .book-editor-item {
    font-family: 'Crimson Text', Georgia, serif;
    font-style: italic;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.52);
    line-height: 1.5;
  }
</style>
